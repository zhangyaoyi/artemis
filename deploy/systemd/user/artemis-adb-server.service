[Unit]
Description=ADB server for Artemis device automation
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=ADB_SERVER_SOCKET=tcp:127.0.0.1:5037
ExecStart=/home/overman/projects/artemis/.venv/lib/python3.12/site-packages/adbutils/binaries/adb -L tcp:5037 nodaemon server
ExecStartPost=/usr/bin/timeout 10 /bin/bash -c 'until /usr/bin/ss -ltnH "sport = :5037" | /usr/bin/grep -q ":5037"; do /usr/bin/sleep 0.2; done'
Restart=always
RestartSec=2
TimeoutStopSec=10
NoNewPrivileges=true

[Install]
WantedBy=default.target
